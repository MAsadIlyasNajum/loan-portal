{
  "name": "auth",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/auth/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/api/auth",
        "command": "jest --config=jest.config.cts --passWithNoTests"
      },
      "dependsOn": ["^build"],
      "inputs": ["default", "^production", "sharedGlobals", { "externalDependencies": ["jest", "ts-jest"] }]
    },
    "seed:admin": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/api/auth",
        "command": "node -r ts-node/register/transpile-only prisma/seed-admin.ts",
        "env": {
          "TS_NODE_PROJECT": "tsconfig.script.json"
        }
      },
      "dependsOn": ["^build"]
    }
  }
}
