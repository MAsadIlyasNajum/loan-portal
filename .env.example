# Database Configuration
# MySQL connection string format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For local development with docker-compose.yml:
DATABASE_URL="mysql://loan_user:loan_password@localhost:3306/loan_portal?schema=public"

# Application Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration (required)
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
# The API refuses to start without a JWT_SECRET of at least 32 characters.
JWT_SECRET="replace-with-a-generated-secret-at-least-32-characters-long"
JWT_EXPIRES_IN="15m"

# Admin bootstrap (used only by `pnpm seed:admin` / `nx run auth:seed:admin`;
# never used during API startup and never committed)
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD="replace-with-a-strong-password"

# Frontend URL (for CORS)
# FRONTEND_URL=http://localhost:4200
