# Database Configuration
# MySQL connection string format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For local development with docker-compose.yml:
DATABASE_URL="mysql://loan_user:loan_password@localhost:3306/loan_portal?schema=public"

# Application Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration (required)
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
# The API refuses to start without a JWT_SECRET of at least 32 characters.
JWT_SECRET="replace-with-a-generated-secret-at-least-32-characters-long"
JWT_EXPIRES_IN="15m"

# Admin bootstrap (used only by `pnpm seed:admin` / `nx run auth:seed:admin`;
# never used during API startup and never committed)
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD="replace-with-a-strong-password"

# Frontend URL (for CORS)
# FRONTEND_URL=http://localhost:4200

# Asynchronous credit checks
# A new application starts as PENDING and a durable,
# database-backed credit check job completes after a
# random delay between CREDIT_CHECK_MIN_DELAY_MS and
# CREDIT_CHECK_MAX_DELAY_MS (10 seconds to 5 minutes by
# default), marking the application APPROVED or REJECTED.
# CREDIT_CHECK_MIN_DELAY_MS=10000
# CREDIT_CHECK_MAX_DELAY_MS=300000
# How often the scheduler polls for due work (ms)
# CREDIT_CHECK_POLL_INTERVAL_MS=1000
# A job whose worker died is considered stale after this (ms)
# CREDIT_CHECK_STALE_JOB_MS=120000
# Bounded retries per attempt burst
# CREDIT_CHECK_MAX_ATTEMPTS=5
# Backoff before a failed job is retried (ms)
# CREDIT_CHECK_RETRY_DELAY_MS=5000
# Cooldown before a FAILED job gets a fresh attempt burst (ms)
# CREDIT_CHECK_FAILED_RETRY_MS=300000
# Simulated bureau approval probability (0..1)
# CREDIT_CHECK_APPROVAL_RATE=0.5
