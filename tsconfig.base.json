{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "paths": {
      "@org/loans": ["./libs/api/loans/src/index.ts"],
      "@org/customers": ["./libs/api/customers/src/index.ts"],
      "@org/auth": ["./libs/api/auth/src/index.ts"],
      "@org/credit-checks": ["./libs/api/credit-checks/src/index.ts"],
      "@org/loan-purposes": ["./libs/api/loan-purposes/src/index.ts"],
      "@org/database": ["./libs/api/database/src/index.ts"],
      "@org/common": ["./libs/api/common/src/index.ts"],
      "@org/ui": ["./libs/web/ui/src/index.ts"],
      "@org/contracts": ["./libs/contracts/shared/src/index.ts"]
    }
  }
}
